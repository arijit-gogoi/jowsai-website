---
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import Enquire from '../../components/Enquire.astro';
import Base from '../../layouts/Base.astro';
import { getDesigns, type Design } from '../../lib/content';

export async function getStaticPaths() {
  const designs = await getDesigns();
  return designs.map((design) => ({ params: { slug: design.slug }, props: { design } }));
}

interface Props {
  design: Design;
}

const { design } = Astro.props;
const { Content } = await render(design.entry);
---

<Base title={design.name} description={design.subtitle}>
  <h1>{design.name}</h1>
  <ul>
    {
      design.gallery.map((item) => (
        <li>
          <Picture src={item.image} alt={item.alt} formats={['avif', 'webp']} />
        </li>
      ))
    }
  </ul>
  <div class="prose">
    <Content />
  </div>
  <Enquire name={design.name} />
</Base>
