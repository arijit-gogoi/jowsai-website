---
import { Font } from 'astro:assets';
import { getHome } from '../lib/content';
import '../styles/global.css';

interface Props {
  /** Page name; omitted on the home page. */
  title?: string;
  description?: string;
}

// The wordmark, tagline and default description come from raw/home.md, like all copy.
const { hero } = await getHome();
const { title, description = hero.lede } = Astro.props;
const pageTitle = title ? `${title} | ${hero.title}` : `${hero.title} — ${hero.tagline}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-display" preload={[{ weight: 600, style: 'normal' }]} />
    <Font cssVariable="--font-text" preload={[{ weight: 400, style: 'normal' }]} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href="/">{hero.title}</a>
      <nav aria-label="Main">
        <a href="/#designs">Designs</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <p class="wordmark">{hero.title}</p>
        <p class="site-footer__tagline">{hero.tagline}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
  }

  .wordmark {
    padding-inline-start: 0.32em;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-decoration: none;
  }

  nav a {
    display: inline-block;
    padding-block: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-accent-text);
  }

  .site-footer {
    margin-top: var(--section-space);
    padding-block: clamp(3rem, 2rem + 4vw, 5rem);
    background: var(--color-dark);
    color: var(--color-on-dark);
  }

  .site-footer__inner {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .site-footer .wordmark {
    font-size: 1.75rem;
  }

  .site-footer__tagline {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-style: italic;
    color: var(--color-on-dark-muted);
  }
</style>
